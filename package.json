{
  "name": "rzutnik",
  "version": "1.4.0",
  "description": "Aplikacja służb Kościoła Na Skale: rzutnik, stream i organizacja nabożeństw",
  "author": "Patryk Dorau",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon --watch electron --ext cjs --exec electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "pl.rzutnik.app",
    "productName": "Kościół Na Skale",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/test-*.cjs",
      "!electron/fake-*.cjs",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "executableName": "KosciolNaSkale"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KosciolNaSkale-instalator-${version}.exe"
    },
    "portable": {
      "artifactName": "KosciolNaSkale-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PatrykDorau",
        "repo": "kns"
      }
    ],
    "electronLanguages": [
      "pl",
      "en-US"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "^6.4.299",
    "pptx-preview": "^1.0.7",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "electron-updater": "^6.8.9",
    "qrcode-generator": "^1.4.4"
  }
}

{
  "name": "rzutnik",
  "version": "1.5.1",
  "description": "Aplikacja służb Kościoła Na Skale: rzutnik, stream i organizacja nabożeństw",
  "author": "Patryk Dorau",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,main,electron \"vite\" \"node skrypty/build-main.mjs --watch\" \"wait-on tcp:127.0.0.1:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon --watch dist-electron --ext js --delay 1 --exec electron .\"",
    "build": "vite build && node skrypty/build-main.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && vue-tsc --noEmit -p web/tsconfig.json",
    "build:main": "node skrypty/build-main.mjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "build:web": "vite build --config web/vite.config.mjs"
  },
  "build": {
    "appId": "pl.rzutnik.app",
    "productName": "Kościół Na Skale",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "executableName": "KosciolNaSkale"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KosciolNaSkale-instalator-${version}.exe"
    },
    "portable": {
      "artifactName": "KosciolNaSkale-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PatrykDorau",
        "repo": "kns"
      }
    ],
    "electronLanguages": [
      "pl",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "^6.4.299",
    "pptx-preview": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "qrcode-generator": "^1.4.4"
  }
}
